Vagrant.configure("2") do |config|

  # Base box
  config.vm.box = "ubuntu/jammy64"

  # ------------------------------------------------------------------
  # Common configuration
  # ------------------------------------------------------------------

  config.vm.synced_folder ".", "/home/vagrant/DPF"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end

  # ------------------------------------------------------------------
  # Nodes
  # ------------------------------------------------------------------

  nodes = {
    "produce"  => "192.168.56.10",
    "map1"     => "192.168.56.11",
    "map2"     => "192.168.56.12",
    "map3"     => "192.168.56.13",
    "map4"     => "192.168.56.14",
    "map5"     => "192.168.56.15",
    "reduce"   => "192.168.56.16"

  }

  nodes.each do |name, ip|

    config.vm.define name do |node|

      node.vm.hostname = name

      # Private network
      node.vm.network "private_network", ip: ip

      # ----------------------------------------------------------------
      # Provisioning
      # ----------------------------------------------------------------

      node.vm.provision "shell", inline: <<-SHELL
        set -e

        echo "========================================="
        echo "Provisioning #{name}"
        echo "========================================="

        # Update package list
        apt-get update

        # Basic packages
        DEBIAN_FRONTEND=noninteractive apt-get install -y \
          python3 \
          python3-pip \
          python3-venv \
          build-essential \
          curl \
          git \
          net-tools \
          iproute2

        # Create virtual environment
        if [ ! -d /home/vagrant/venv ]; then
          python3 -m venv /home/vagrant/venv
        fi
        # Upgrade pip
        /home/vagrant/venv/bin/python -m pip install --upgrade pip
        # Install requirements if available
        if [ -f /home/vagrant/DPF/requirements.txt ]; then
          /home/vagrant/venv/bin/pip install -r /home/vagrant/DPF/requirements.txt
        fi
        # Make sure vagrant owns the files
        chown -R vagrant:vagrant /home/vagrant/venv
        chown -R vagrant:vagrant /home/vagrant/DPF
        echo "========================================="
        echo "#{name} provisioning completed"
        echo "IP: #{ip}"
        echo "Python: /home/vagrant/venv/bin/python"
        echo "========================================="
      SHELL

    end
  end
end
